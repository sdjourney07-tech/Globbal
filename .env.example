# Copy to .env and fill in your Atlas password.
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@clusterglobble.yjb5lqt.mongodb.net/ClusterGlobble?retryWrites=true&w=majority&appName=ClusterGlobble
MONGODB_DB=ClusterGlobble

# Password-reset emails via Resend (https://resend.com)
# Without RESEND_API_KEY, local forgot-password shows a clickable reset link only for
# true loopback requests (or when ALLOW_DEV_RESET_LINKS=1). Never enable that flag in production.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=Globbal <onboarding@resend.dev>
# For real email to other people, verify a domain in Resend and use that in EMAIL_FROM.
# APP_PUBLIC_URL=https://your-app.example.com
# ALLOW_DEV_RESET_LINKS=1
